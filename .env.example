# WirePay Orchestrator - Local Development Environment
# Copy to .env and adjust as needed.
# Thomas Wire <tom@thomaswire.com>

# Database
DATABASE_URL=postgres://wpo:wpo_dev_password@localhost:54320/wirepay?sslmode=disable

# Redis
REDIS_URL=redis://localhost:6379

# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# OpenTelemetry (optional — disabled by default)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# Per-service ports (override SERVICE_PORT in docker-compose if needed)
WIRE_ORDER_PORT=8081
WIRE_INVENTORY_PORT=8082
WIRE_PAYMENT_PORT=8083
WIRE_NOTIFICATION_PORT=8084
WIRE_LEDGER_PORT=8085

# Stripe mock mode (set to "false" when integrating real Stripe)
STRIPE_MOCK_MODE=true
